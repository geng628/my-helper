{
  "enabled_tools": [
    "list_files",
    "search_markdown",
    "read_markdown",
    "search_chat_history",
    "write_file",
    "remember_fact",
    "save_rule",
    "get_current_time",
    "save_study_card",
    "list_due_reviews",
    "run_command",
    "web_search",
    "fetch_webpage"
  ],
  "plugins": ["plugins"],
  "retrieval": {
    "plugin": "rag",
    "min_term_coverage": 0.22,
    "min_bm25_score": 0.1,
    "max_hits_per_file": 2,
    "parent_max_chars": 1000,
    "child_max_chars": 320,
    "child_overlap_chars": 64,
    "min_vector_score": 0.45,
    "rrf_k": 60,
    "bm25_weight": 1.0,
    "vector_weight": 1.0,
    "rerank_candidates": 50,
    "min_rerank_score": 0.15,
    "allowed_access": ["public"],
    "post_retrieval": {
      "dedup_similarity": 0.82,
      "max_context_chars": 6000,
      "max_chars_per_hit": 1200,
      "compress_long_hits": true,
      "lost_in_middle_reorder": false,
      "crag_enabled": true,
      "crag_high_threshold": 0.65,
      "crag_low_threshold": 0.25,
      "max_corrective_rewrites": 1
    },
    "query_optimization": {
      "enabled": false,
      "routing": true,
      "rewrite": true,
      "multi_query": true,
      "hyde": true,
      "max_sub_queries": 3
    }
  },
  "telemetry": {
    "enabled": true,
    "max_sessions": 256
  },
  "web": {
    "timeout": 15,
    "max_download_bytes": 2097152,
    "max_output_bytes": 8192,
    "max_results": 5
  },
  "shell": {
    "allowed_executables": [
      "ls",
      "find",
      "grep",
      "rg",
      "wc",
      "head",
      "tail",
      "cat",
      "pwd",
      "date",
      "df",
      "git",
      "pytest"
    ],
    "allowed_git_subcommands": ["status", "log", "diff", "show", "branch", "rev-parse"],
    "cwd": ".",
    "timeout": 10,
    "max_output_bytes": 8192,
    "reject_segments": [".env", ".git", ".ssh", "state", "uploads", "models.dsl", "models.json"]
  },
  "files": {
    "read_roots": ["data/memory", "data/workspace", "docs"],
    "write_root": "data/workspace",
    "max_read_bytes": 65536,
    "max_write_bytes": 65536,
    "max_lines": 400,
    "max_results": 100,
    "reject_segments": [".env", ".git", "state", ".ssh", "uploads", "models.dsl", "models.json"]
  },
  "commands": [
    {
      "name": "git_status",
      "description": "查看项目仓库的未提交改动。",
      "enabled": true,
      "argv": ["git", "status", "--short"],
      "cwd": ".",
      "timeout": 10,
      "max_output_bytes": 8192
    },
    {
      "name": "disk_usage",
      "description": "查看磁盘空间占用。",
      "enabled": true,
      "argv": ["df", "-h"],
      "cwd": ".",
      "timeout": 10,
      "max_output_bytes": 8192
    }
  ]
}
